PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.<id>.mongodb.net/hotel-chatbot?retryWrites=true&w=majority
JWT_SECRET=your_long_random_secret_here

# OpenAI — used for chat (GPT-4o). Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# Groq — kept for Whisper STT (voice transcription). Get your key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
FRONTEND_URL=http://localhost:3000
