PORT=5000

# Local MongoDB (default — no installation of Atlas required)
MONGO_URI=mongodb://127.0.0.1:27017/haile-hotel

# To use MongoDB Atlas instead, replace with your connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.<id>.mongodb.net/haile-hotel?retryWrites=true&w=majority

JWT_SECRET=change_me_to_a_long_random_string

# OpenAI — used for GPT chat (gpt-4o) AND Whisper STT (voice transcription)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

NODE_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
FRONTEND_URL=http://localhost:3000
